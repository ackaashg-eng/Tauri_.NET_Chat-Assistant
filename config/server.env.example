# ---------------------------------------------------------------------------
# Settings of the SPIL Labs server. Copy to config/server.env
# (scripts/setup.ps1 creates it for you). Relative paths are relative to the project folder.
# ---------------------------------------------------------------------------

# The C# MCP server executable (published by setup.ps1). The Rust MCP client inside
# spil-backend starts it as a child process and talks to it over STDIO - no network port.
MCP_SERVER_COMMAND=dist\server\SemanticSearch.McpServer.exe
# Arguments: the SQL Server connection string and the regex rules file (JSON list).
MCP_SERVER_ARGS=["--connection","Server=localhost\\SQLEXPRESS;Database=LumenSearch;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True","--rules","C:/path/to/mcp-semantic-search/server-dotnet/SemanticSearch.McpServer/Rules/search-rules.json"]
MCP_REQUEST_TIMEOUT=30
MCP_STARTUP_TIMEOUT=180

# Long random secret that signs login tokens (32+ characters; setup.ps1 generates one).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRE_MINUTES=480

# First administrator - created on first start only if there are no accounts yet.
# Remove ADMIN_PASSWORD after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

USERS_DB_PATH=data/users.db
FRONTEND_DIST=frontend/dist
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Only needed while developing with the Vite dev server (npm run dev).
CORS_ORIGINS=http://localhost:5173
# HOST=127.0.0.1   (run.ps1 -Lan uses 0.0.0.0)
# PORT=8000
