<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain console application. There is NO ASP.NET / Web API here:
    the MCP client starts this program and talks to it over stdin/stdout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SemanticSearch.McpServer</AssemblyName>
    <RootNamespace>SemanticSearch.McpServer</RootNamespace>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official MCP C# SDK (stdio server transport + tool attributes) -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Microsoft SQL Server driver -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.5" />
    <!--
      SqlClient 6.1.5 pulls in System.Security.Cryptography.Pkcs 9.0.11, which has two denial-of-service
      advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). 10.0.13 is the patched release for .NET 10.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Database\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Rules\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
