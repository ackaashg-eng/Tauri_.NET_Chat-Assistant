{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },

  "SemanticSearch": {
    // Microsoft SQL Server connection. "Trusted_Connection=True" = log in with your Windows account.
    // SQL Server Express usually runs as  localhost\SQLEXPRESS ; Developer/Standard as  localhost
    // Override with the command-line option:  --connection "Server=...;Database=...;..."
    "ConnectionString": "Server=localhost\\SQLEXPRESS;Database=LumenSearch;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True",

    // Create the database (if it does not exist) and the sample tables + rows (if they are empty).
    // Each schema script runs on every start but only creates what is missing;
    // its seed script runs only while CheckTable is empty.
    "CreateDatabaseIfMissing": true,
    "CreateSampleData": true,
    "SampleData": [
      { "Name": "Electronics shop", "SchemaScript": "Database/schema.sql", "SeedScript": "Database/seed.sql", "CheckTable": "dbo.products" },
      { "Name": "ERP consultations", "SchemaScript": "Database/erp-schema.sql", "SeedScript": "Database/erp-seed.sql", "CheckTable": "dbo.erp_consultations" }
    ],

    // The regex rules that make search "semantic". Override with:  --rules "C:\path\search-rules.json"
    "RulesFile": "Rules/search-rules.json",

    // Which tables are searchable. Add your own tables here ("dbo.my_table" or "my_table").
    //   TextColumns    -> searched by the regex rules
    //   DisplayColumns -> returned to the UI with each result
    "Sources": [
      {
        "Name": "products",
        "DisplayName": "Products",
        "Description": "Product catalogue: TVs, audio, computers, phones, smart home and appliances.",
        "Table": "dbo.products",
        "IdColumn": "id",
        "TitleColumn": "name",
        "TextColumns": [ "name", "category", "description" ],
        "DisplayColumns": [ "sku", "category", "price", "stock", "warranty_months" ]
      },
      {
        "Name": "articles",
        "DisplayName": "Help articles",
        "Description": "Customer help-centre articles: delivery, returns, billing, troubleshooting.",
        "Table": "dbo.articles",
        "IdColumn": "id",
        "TitleColumn": "title",
        "TextColumns": [ "title", "category", "body", "tags" ],
        "DisplayColumns": [ "category", "tags", "updated_at" ]
      },
      // ---- ERP consultancy (sources are views that join in client/consultant names) ----
      {
        "Name": "consultations",
        "DisplayName": "Consultations",
        "Description": "ERP consultation bookings: what the client needed, status and outcome.",
        "Table": "dbo.v_erp_consultations",
        "IdColumn": "id",
        "TitleColumn": "title",
        "TextColumns": [ "title", "client", "consultant", "erp_module", "consultation_type", "description", "outcome" ],
        "DisplayColumns": [ "client", "consultant", "erp_module", "status", "priority", "scheduled_start" ]
      },
      {
        "Name": "meetings",
        "DisplayName": "Meetings",
        "Description": "Consultation meetings: agenda, notes and action items.",
        "Table": "dbo.v_erp_meetings",
        "IdColumn": "id",
        "TitleColumn": "title",
        "TextColumns": [ "title", "client", "agenda", "notes", "action_items" ],
        "DisplayColumns": [ "client", "consultant", "meeting_at", "mode", "consultation_id" ]
      },
      {
        "Name": "feedback",
        "DisplayName": "Feedback",
        "Description": "What clients said about their consultations, with ratings.",
        "Table": "dbo.v_erp_feedback",
        "IdColumn": "id",
        "TitleColumn": "title",
        "TextColumns": [ "title", "client", "consultant", "erp_module", "comments" ],
        "DisplayColumns": [ "client", "consultant", "rating", "would_recommend", "follow_up_required", "submitted_at" ]
      },
      {
        "Name": "orders",
        "DisplayName": "Orders",
        "Description": "Quotes and orders for consultancy work, with amounts and payment status.",
        "Table": "dbo.v_erp_orders",
        "IdColumn": "id",
        "TitleColumn": "title",
        "TextColumns": [ "title", "client", "service", "status", "notes" ],
        "DisplayColumns": [ "order_number", "client", "amount", "currency", "status", "order_date" ]
      }
    ]
  }
}
