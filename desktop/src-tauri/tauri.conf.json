{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SPIL Labs Assistant",
  "version": "1.0.0",
  "identifier": "com.spillabs.assistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SPIL Labs Assistant",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "SPIL Labs",
    "shortDescription": "SPIL Labs Assistant",
    "longDescription": "Desktop app for the SPIL Labs assistant: ask about ERP consultations, clients, orders and products.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
